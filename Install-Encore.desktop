[Desktop Entry]
Type=Application
Name=Install Encore
Comment=Installs Beat Saber 1.40.8 with custom-song and custom-map mods on this Steam Frame
Icon=system-software-install
Exec=konsole --hold -e bash -c "curl -fsSL -o /tmp/encore-install.sh https://github.com/jimas21/encore/releases/latest/download/install.sh || { echo 'Could not download the installer. Check that the headset is online, then try again.'; exit 1; }; bash /tmp/encore-install.sh || echo 'The installer stopped. The message above says why.'"
Terminal=false
